{
  "name": "Research Topic Validation",
  "install": "./scripts/cloud-agent-install.sh",
  "ports": [
    { "name": "web", "port": 3000 },
    { "name": "api", "port": 8000 }
  ],
  "terminals": [
    {
      "name": "api",
      "command": "cd services/api && .venv/bin/python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "description": "FastAPI backend on port 8000"
    },
    {
      "name": "web",
      "command": "cd apps/web && npx next dev -H 0.0.0.0 -p 3000",
      "description": "Next.js frontend on port 3000"
    }
  ]
}
